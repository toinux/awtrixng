# @name    anothertime
# @desc    Always see time and other widgets
# @author  toinux@gmail.com
# @version 1.0
# @config  sc  color  "Seconds color"      default=#FF00FF
# @config  ta  select "Time animation" options=scroll,fade default=fade
# @config  tad  slider "Time animation duration" min=100 max=5000 default=500 unit=ms
import math
var PI = 3.14159265

# widgets
var widgets = [
      {"name": "date", "duration": 2},
      {"name": "temperature", "duration": 6},
      {"name": "humidity", "duration": 2}
    ]

def digits(h, m)
  return [h / 10, h % 10, m / 10, m % 10]
end

def previous_digits(h, m)
  var pm = m - 1
  var ph = h
  if pm < 0
    pm = 59
    ph = h - 1
    if ph < 0
      ph = 23
    end
  end
  return digits(ph, pm)
end

class MyApp
  var cur
  var prev
  var ticks

  var widgets              # liste ordonnée {name, duration} (duration en secondes)
  var index                # index du widget courant dans la liste
  var current_widget       # nom du widget affiché en ce moment
  var previous_widget      # nom du widget affiché juste avant (pour la transition)
  var wticks                # compte à rebours (en secondes, via loop()) avant le prochain switch
  var transition_start_ms  # instant (now_ms) du début de transition, nil si aucune en cours
  var transition_duration_ms  # durée de la transition en ms

  def init()           # once, when the app is loaded
    self.cur=[nil, nil, nil, nil]

    self.index = 0
    self.current_widget = widgets[0]["name"]
    self.previous_widget = nil
    self.wticks = widgets[0]["duration"]
    self.transition_start_ms = nil
    self.transition_duration_ms = 1000     # <- durée de la transition, ajustable

  end

  def loop()           # ~1x/s, also while the app is hidden

     if self.wticks <= 0
      self.previous_widget = self.current_widget
      self.index = (self.index + 1) % size(widgets)
      self.current_widget = widgets[self.index]["name"]
      self.wticks = widgets[self.index]["duration"]
      self.transition_start_ms = epoch_ms()
    end
    self.wticks -= 1

  end
  
  def calculate_cur_prev()
      var h = hour()
      var m = minute()
      self.cur = digits(h, m)
      self.prev = previous_digits(h, m)
  end

  def pad(v)
    if v < 10 return "0" + str(v) end
    return str(v)
  end
  
  def fade_color(color, pct)
    if (nil == color) 
      return self.fade_color(0xFFFFFF, pct) 
    end
    var r = (color >> 16) & 0xFF
    var g = (color >> 8) & 0xFF
    var b = color & 0xFF
    return rgb(r * pct, g * pct, b * pct)
  end

  def draw_time()
    var ems = epoch_ms()
    var sec = second()
    var xpos = 0
    var ypos = 6
    var tc = settings.get("timeColor")
    if tc == nil
      tc = settings.get("textColor")
    end

    # separator
    var frac = (ems % 1000) / 1000.0
    var sepcolor = nil
    if sec % 2 > 0
      var pct = (math.cos(2 * PI * frac + PI) + 1) * 0.5
      sepcolor = self.fade_color(tc, pct)
      text(xpos + 8,ypos,":",sepcolor)
    end
    
    # digits
    var mms = ems % 60000
    var tad = store.get("tad")
    if mms < tad
      var pct = real(mms) / tad
      for i : 0 .. 3
        if self.cur[i] != self.prev[i]
          # ici animation
          
          if (store.get("ta") == "scroll")
            # scroll
            var spos = int(pct * 8)
            text(xpos,ypos + spos - 8,str(self.cur[i]),tc)
            text(xpos,ypos + spos,str(self.prev[i]),tc)
          else
            # fade
            var digitToPrint = (pct < 0.5) ? self.prev[i] : self.cur[i]
            var c = self.fade_color(tc, (math.cos(2 * PI * pct) + 1) * 0.5)
            text(xpos,ypos,str(digitToPrint),c)
          end

        else
          text(xpos,ypos,str(self.cur[i]),tc)
        end
        xpos += 4
        if i == 1
          # ici on decale si separateur
          xpos += 2
        end
      end
    else
      text(0,6,self.pad(hour()),tc)
      text(10,6,self.pad(minute()),tc)
    end
  end
  
def draw_seconds()
  var sc = store.get("sc")
  var secw = 17 # nombre de pixels à afficher
  var ms_elapsed = epoch_ms() % 60000  # ms écouées depuis le début de la minute

  var valeur = (ms_elapsed * secw) / 59000.0  # équivalent flottant de ta formule d'origine
  var filled = int(valeur)
  var pct = valeur - filled

  # pixels pleins
  for i : 0 .. filled - 1
    pixel(i, 7, sc)
  end

  # pixel partiellement rempli
  if filled < secw
    pixel(filled, 7, self.fade_color(sc, pct))
  end
end

  def draw_widget(name, offset, pct)

      var ox=19
      var oy=offset

      var white = self.fade_color(0xFFFFFF,pct)

    var letter = "?"
    if name == "date"
      
      
      var grey = self.fade_color(0x8B898C,pct)
      var blue = self.fade_color(0x0036FF,pct)
      
    rect_fill(ox, oy+1, 5, 2, blue)
    rect_fill(ox, oy+3, 5, 3, white)
    line(ox+1, oy, ox+1, oy+1, grey)
    line(ox+3, oy, ox+3, oy+1, grey)
    pixel(ox+1, oy+4, grey)
    pixel(ox+3, oy+4, grey)

      letter = str(day())
    elif name == "temperature"
      

     var red = self.fade_color(0xFF4C50,pct)
    pixel(ox+2, oy, white)
    line(ox+1, oy+1, ox+1, oy+2, white)
    line(ox+3, oy+1, ox+3, oy+2, white)
    pixel(ox+2, oy+2, red)
    rect_fill(ox, oy+3, 5, 2, white)
    rect_fill(ox+1, oy+3, 3, 2, red)
    rect_fill(ox+1, oy+5, 3, 1, white)

      letter = str(sensor.temperature())
    elif name == "humidity"
      

          var l  = self.fade_color(0xD5F6FF,pct)
          var m1 =  self.fade_color(0xBDF3FF,pct)
          var m2 = self.fade_color(0x62E2FF,pct)
          var m3 = self.fade_color(0x40DAFE,pct)
          var d1 = self.fade_color(0x00AEFF,pct)
          var d2 = self.fade_color(0x0089CD,pct)
          var w = white
      
    pixel(ox+2, oy, l)
    pixel(ox+2, oy+1, m1)
    pixel(ox+1, oy+2, w) pixel(ox+2, oy+2, m1) pixel(ox+3, oy+2, m2)
    pixel(ox, oy+3, w) pixel(ox+1, oy+3, m1) pixel(ox+2, oy+3, m1)
    pixel(ox+3, oy+3, m2) pixel(ox+4, oy+3, d1)
    pixel(ox, oy+4, w) pixel(ox+1, oy+4, m2) pixel(ox+2, oy+4, m2)
    pixel(ox+3, oy+4, m3) pixel(ox+4, oy+4, d2)
    pixel(ox+1, oy+5, d1) pixel(ox+2, oy+5, d1) pixel(ox+3, oy+5, d2)

      letter = str(sensor.humidity())
    end
    text(25, 6, letter, self.fade_color(0xFFFFFF, pct))
  end

  def draw_widgets()
    if self.transition_start_ms != nil
      var elapsed = epoch_ms() - self.transition_start_ms
      if elapsed >= self.transition_duration_ms
        self.transition_start_ms = nil
        self.draw_widget(self.current_widget, 0, 1.0)
      else
        var pct = elapsed * 1.0 / self.transition_duration_ms   # 0 -> 1

        var widgetToPrint = (pct < 0.5) ? self.previous_widget : self.current_widget
        self.draw_widget(widgetToPrint, 0, (math.cos(2 * PI * pct) + 1) * 0.5)
        
      end
    else
      self.draw_widget(self.current_widget, 0, 1.0)
    end
  end

  def draw()

    if minute() % 10 != self.cur[3]
      self.calculate_cur_prev()
    end

    
    clear()
    self.draw_time()
    self.draw_seconds()
    self.draw_widgets()

  end

end

return MyApp()
