# @name Anothertime
# @desc Always see time and other widgets
# @author toinux@gmail.com
# @version 1.3
# @config sc color "Seconds color" default=#FF00FF
# @config ta select "Time animation" options=scroll,fade default=fade
# @config tad slider "Time animation duration" min=100 max=2000 default=500 unit=ms
# @config dsty select "Date style" default=icon options=icon,calendar
# @config wsty select "Week style" default=dotted2 options=large,progress,dotted,dotted2
# @config wc color "Week days color" default=#00FFFF
# @config wdc color "Current day color" default=#FF00FF
# @config ssun bool "Week starts Sunday" default=false
# @config wa select "Widgets animation" options=scroll,fade default=fade
# @config wad slider "Widgets animation duration" min=100 max=2000 default=500 unit=ms
# @config btopic text "Battery topic" default=""
# @config wlist text "Widgets" default="date,temperature,humidity,battery" help="ex: date,temperature@5,humidity,date@4,battery" maxlen=200

import math

class MyApp
  var cur, prev   # digits courants/précédents
  var hh, mm      # heure et minute courantes (pour éviter de recalculer à chaque draw())
  var cur_min

  var widgets            # liste {name, duration} construite une fois
  var wdur                # durée par défaut d'un widget, mise en cache
  var index, wticks
  var current_widget, previous_widget
  var transition_start_ms, transition_duration_ms

  var week_style, week_color, day_color, start_sunday # style et couleurs de la semaine (lues une seule fois)

  var sc, ta, tad, wa, wad         # config mise en cache (lue une seule fois)
  var tc                  # text color from settings

  var temp, hum, lbat   # libellés capteurs, construits en loop()
  var mbat # boolean pour savoir si on a un topic mqtt pour la batterie
  var bat # valeur de la batterie (0-100) ou -1 si non disponible
  var day_n, day_s, dsty

  var date_c, temp_c, hum_c, bat_c, ch_c, cb_c, ct_c # colors from settings

  var sbed, seconds_end_start

  def parse_widgets()
    var result = []
    var raw = store.get("wlist")

    if raw != nil
      for t : re.matchall("[^,]+", raw)
        var m = re.match("(date|temperature|humidity|battery)(@([0-9]+))?$", t)
        if m != nil
          result.push({"name": m[1],
                       "duration": m[3] == nil ? self.wdur : clamp(num(m[3], self.wdur), 1, 60)})
        end
      end
    end

    if size(result) == 0
      result.push({"name": "date", "duration": self.wdur})
    end
    return result
  end

  def init()

    # update values (date, system settings, sensors ...)
    self.update()

    self.cur = ["0", "0", "0", "0"]
    self.prev = ["0", "0", "0", "0"]
    self.cur_min = nil

    self.wdur = 3 # default widget duration in seconds, read once from settings
    self.widgets = self.parse_widgets()

    self.index = 0
    self.current_widget = self.widgets[0]["name"]
    self.previous_widget = nil
    self.wticks = self.widgets[0]["duration"]
    self.transition_start_ms = nil
    self.wa = store.get("wa")
    self.wad = store.get("wad")

    self.sc = store.get("sc")
    self.ta = store.get("ta")
    self.tad = store.get("tad")

    self.sbed = 500  # durée de l'effet de fin des secondes (ms)
    self.seconds_end_start = nil   # moment où on a déclenché l'effet de fin
    
    self.week_style = store.get("wsty")
    # week_color and day_color cannot be reachable by a flat key
    self.week_color = store.get("wc")
    self.day_color = store.get("wdc")
    self.start_sunday = store.get("ssun")

    self.dsty = store.get("dsty")

    self.lbat = "?"
    self.bat = -1
    var btopic = store.get("btopic")
    if btopic != nil && size(btopic) > 0
      mqtt.subscribe(btopic, / t, p -> self.setbat(p))
      self.mbat = true
    else
      self.mbat = false
    end
  end

  def update()
    
    # sensors
    var t = sensor.temperature()
    self.temp = t == nil ? "?" : str(round(settings.get("useCelsius") ? t : (t * 1.8 + 32)))
    var hmd = sensor.humidity()
    self.hum = hmd == nil ? "?" : str(round(hmd))

    # on ne lit la batterie depuis le sensor que si on n'a pas de topic mqtt pour ça
    if !self.mbat
      self.setbat(sensor.battery())
    end

    self.day_n = day()
    self.day_s = str(self.day_n)
    self.tc = self.getcolor("timeColor")
    self.date_c = self.getcolor("dateColor")
    self.temp_c = self.getcolor("temperatureColor")
    self.hum_c = self.getcolor("humidityColor")
    self.bat_c = self.getcolor("batteryColor")
    self.ch_c = self.getcolor("calendarHeaderColor")
    self.cb_c = self.getcolor("calendarBodyColor")
    self.ct_c = self.getcolor("calendarTextColor")
  end

  def getcolor(name)
    var c = settings.get(name)
    return c == nil ? settings.get("textColor") : c
  end

  def setbat(b)
    self.bat = b == nil ? -1 : num(b)
    self.lbat = self.bat < 0 ? "?" : str(self.bat)
  end

  def loop()
    # rotation des widgets
    if self.wticks <= 0
      if size(self.widgets) > 1
        self.previous_widget = self.current_widget
        self.index = (self.index + 1) % size(self.widgets)
        self.current_widget = self.widgets[self.index]["name"]
        self.wticks = self.widgets[self.index]["duration"]
        self.transition_start_ms = epoch_ms()
      else
        # un seul widget : pas de transition, on relance juste le compte à rebours
        self.wticks = self.widgets[0]["duration"]
      end
    end
    self.wticks -= 1

    # update values
    self.update()
  end

  def calculate_cur_prev()
    var h = hour()
    var m = minute()
    self.cur = [str(h / 10), str(h % 10), str(m / 10), str(m % 10)]

    self.hh = self.cur[0] + self.cur[1]
    self.mm = self.cur[2] + self.cur[3]

    var pm = m - 1
    var ph = h
    if pm < 0 pm = 59 ph = (h - 1 < 0) ? 23 : h - 1 end
    self.prev = [str(ph / 10), str(ph % 10), str(pm / 10), str(pm % 10)]

    self.cur_min = m
  end

  def fade_color(color, pct)
    if color == nil return self.fade_color(0xFFFFFF, pct) end
    if pct >= 1.0 return color end
    var r = (color >> 16) & 0xFF
    var g = (color >> 8) & 0xFF
    var b = color & 0xFF
    return rgb(int(r * pct), int(g * pct), int(b * pct))
  end

  def draw_widget(name, pct, oy)
    var ox = 19
    var w = self.fade_color(0xFFFFFF, pct)
    var c = self.tc
    var v = ""

    if name == "date"
      if self.dsty == "calendar"
        c = self.ct_c
        ox = 21
        rect_fill(ox, oy, 11, 2, self.fade_color(self.ch_c, pct))
        rect_fill(ox, oy+2, 11, 5, self.fade_color(self.cb_c,pct))
        ox -= self.day_n < 10 ? 2 : 4
      
      else
        var grey = self.fade_color(0x8B898C, pct)
        var blue = self.fade_color(0x0036FF, pct)
        rect_fill(ox, oy + 1, 5, 2, blue)
        rect_fill(ox, oy + 3, 5, 3, w)
        line(ox + 1, oy, ox + 1, oy + 1, grey)
        line(ox + 3, oy, ox + 3, oy + 1, grey)
        pixel(ox + 1, oy + 4, grey)
        pixel(ox + 3, oy + 4, grey)
        c = self.date_c
      end
     v = self.day_s

    elif name == "temperature"
      var red = self.fade_color(0xFF4C50, pct)
      pixel(ox + 2, oy, w)
      line(ox + 1, oy + 1, ox + 1, oy + 2, w)
      line(ox + 3, oy + 1, ox + 3, oy + 2, w)
      pixel(ox + 2, oy + 2, red)
      rect_fill(ox, oy + 3, 5, 2, w)
      rect_fill(ox + 1, oy + 3, 3, 2, red)
      rect_fill(ox + 1, oy + 5, 3, 1, w)
      v = self.temp
      c = self.temp_c

    elif name == "battery"
      var green = self.fade_color(0x00FF00, pct)
      rect(ox, oy, 5, 6, w)
      pixel(ox, oy, 0x000000)
      pixel(ox+4, oy, 0x000000)
      for i:1..4
        if self.bat > (100 - 25 * i)
          line(ox + 1, oy + i, ox + 3, oy + i, green)
        end
      end
      pixel(ox+1, oy+1, w)
      pixel(ox+3, oy+1, w)
      v = self.lbat
      c = self.bat_c

    elif name == "humidity"
      var l = self.fade_color(0xD5F6FF, pct)
      var m1 = self.fade_color(0xBDF3FF, pct)
      var m2 = self.fade_color(0x62E2FF, pct)
      var m3 = self.fade_color(0x40DAFE, pct)
      var d1 = self.fade_color(0x00AEFF, pct)
      var d2 = self.fade_color(0x0089CD, pct)
      pixel(ox + 2, oy, l)
      pixel(ox + 2, oy + 1, m1)
      rect_fill(ox + 1, oy + 2, 3, 3, m2)
      rect_fill(ox + 1, oy + 2, 2, 2, m1)
      pixel(ox + 1, oy + 2, l)
      line(ox, oy + 3, ox , oy + 4, w)
      pixel(ox + 4, oy + 3, d1)
      pixel(ox + 1, oy + 2, w)
      pixel(ox + 3, oy + 4, m3)
      pixel(ox + 4, oy + 4, d2)
      line(ox + 1, oy + 5, ox + 2, oy + 5, d1) pixel(ox + 3, oy + 5, d2)
      v = self.hum
      c = self.hum_c

    end

    var f = self.fade_color(c, pct)
    if size(v) > 2
      scroll_text(ox + 6, oy + 6, 6, v, f, {"mode": "bounce", "speed": 40})
    else
      text(ox + 6, oy + 6, v, f)
    end
  end

  def draw()
    if minute() != self.cur_min
      self.calculate_cur_prev()
    end

    clear()

    var ems = epoch_ms()
    var mms = ems % 60000     # milliseconds elapsed in current minute
    
    #################
    # draw time
    #################
    var xpos = 0
    var ypos = 6

    if second() % 2 > 0
      var frac = (ems % 1000) / 1000.0
      var pct = (math.cos(2 * math.pi * frac + math.pi) + 1) * 0.5
      text(xpos + 8, ypos, ":", self.fade_color(self.tc, pct))
    end


    if mms < self.tad
      var pct = real(mms) / self.tad
      for i:0..3
        if self.cur[i] != self.prev[i]
          if self.ta == "scroll"
            var spos = int(pct * 8)
            text(xpos, ypos + spos - 8, self.cur[i], self.tc)
            text(xpos, ypos + spos, self.prev[i], self.tc)
          else
            var s = (pct < 0.5) ? self.prev[i] : self.cur[i]
            text(xpos, ypos, s, self.fade_color(self.tc, (math.cos(2 * math.pi * pct) + 1) * 0.5))
          end
        else
          text(xpos, ypos, self.cur[i], self.tc)
        end
        xpos += 4
        if i == 1 xpos += 2 end
      end
    else
      text(0, 6, self.hh, self.tc)
      text(10, 6, self.mm, self.tc)
    end



    #################
    # draw seconds
    #################
    var secw = 17

    # Détection du passage de minute (on est dans les X dernières ms)
    if mms >= 60000 - self.sbed && self.seconds_end_start == nil
      self.seconds_end_start = ems
    end

    # Reset au début de la nouvelle minute
    if mms < 100
      self.seconds_end_start = nil
    end

    var filled = 0
    var pct = 0.0

    if self.seconds_end_start != nil
      # effet rewind
      var elapsed = ems - self.seconds_end_start
      var t = clamp(elapsed * 1.0 / self.sbed, 0.0, 1.0)

        var remaining = secw * (1.0 - t)
        filled = int(remaining)
        pct = remaining - filled

    else
      # comportement normal pendant la minute
      var valeur = (mms * secw) / 59000.0
      filled = int(valeur)
      pct = valeur - filled
    end

    for i:0..filled - 1
      pixel(i, 7, self.sc)
    end
    if filled < secw
      pixel(filled, 7, self.fade_color(self.sc, pct))
    end

    #################
    # draw widgets
    #################
    if self.transition_start_ms != nil
      var elapsed = ems - self.transition_start_ms
      if elapsed >= self.wad
        self.transition_start_ms = nil
        self.draw_widget(self.current_widget, 1.0, 0)
      else
        var pct = elapsed * 1.0 / self.wad

        if self.wa == "scroll"
          # anination scroll
          var spos = int(pct * 8)
          self.draw_widget(self.current_widget, 1, spos - 8)
          self.draw_widget(self.previous_widget, 1, spos)
        else
          # animation fade
          self.draw_widget((pct < 0.5) ? self.previous_widget : self.current_widget, (math.cos(2 * math.pi * pct) + 1) * 0.5, 0)
        end

      end
    else
      self.draw_widget(self.current_widget, 1.0, 0)
    end

    #################
    # draw week
    #################
    var wd = self.start_sunday ? weekday() : (weekday() + 6) % 7   # 0 = premier jour de semaine
    xpos = 18

    if self.week_style == "large"
      line(xpos, 7, 31, 7, self.week_color)
      line(xpos + wd * 2, 7, xpos + wd * 2 + 1, 7, self.day_color)

    elif self.week_style == "progress"
      line(xpos, 7, 31, 7, self.week_color)
      line(xpos, 7, xpos + wd * 2 + 1, 7, self.day_color)

    elif self.week_style == "dotted"
      line(xpos, 7, 31, 7, 0x000000)
      var i = 0
      while i < 7
        pixel(xpos + i * 2, 7, i == wd ? self.day_color : self.week_color)
        i += 1
      end

    elif self.week_style == "dotted2"
      line(xpos, 7, 31, 7, 0x000000)
      var i = 0
      var x = xpos
      while i < 7
        if i == wd
          line(x, 7, x + 1, 7, self.day_color)
          x += 3
        else
          pixel(x, 7, self.week_color)
          x += 2
        end
        i += 1
      end
    end

  end


end

return MyApp()