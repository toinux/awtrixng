# Configuration de déploiement AWTRIX
# Copiez ce fichier vers .env et adaptez les valeurs

# IP ou hostname de l'appareil AWTRIX (ex: 192.168.1.202 ou awtrixng-xxxxxx.local)
AWTRIX_IP=192.168.1.202

# Authentification optionnelle (si l'appareil a l'auth activée)
# Format: user:pass
# AWTRIX_AUTH=user:pass